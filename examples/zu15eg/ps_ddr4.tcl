# XCZU15EG Core V1.0: four MT40A512M16LY-062E x16 devices, one 64-bit rank.
# Match the companion board's DDR and UART settings, including its 33.333 MHz PS reference.
set_property -dict [list \
 CONFIG.PSU__PSS_REF_CLK__FREQMHZ 33.333333 \
 CONFIG.PSU__DDRC__ENABLE 1 \
 CONFIG.PSU__DDRC__MEMORY_TYPE {DDR 4} \
 CONFIG.PSU__DDRC__COMPONENTS Components \
 CONFIG.PSU__DDRC__VENDOR_PART OTHERS \
 CONFIG.PSU__DDRC__BUS_WIDTH {64 Bit} \
 CONFIG.PSU__DDRC__DRAM_WIDTH {16 Bits} \
 CONFIG.PSU__DDRC__DEVICE_CAPACITY {8192 MBits} \
 CONFIG.PSU__DDRC__RANK_ADDR_COUNT 0 \
 CONFIG.PSU__DDRC__BG_ADDR_COUNT 1 \
 CONFIG.PSU__DDRC__BANK_ADDR_COUNT 2 \
 CONFIG.PSU__DDRC__ROW_ADDR_COUNT 16 \
 CONFIG.PSU__DDRC__COL_ADDR_COUNT 10 \
 CONFIG.PSU__DDRC__SPEED_BIN DDR4_2400T \
 CONFIG.PSU__CRF_APB__DDR_CTRL__FREQMHZ 1200 \
 CONFIG.PSU__DDRC__CL 18 \
 CONFIG.PSU__DDRC__CWL 12 \
 CONFIG.PSU__DDRC__T_RCD 18 \
 CONFIG.PSU__DDRC__T_RP 18 \
 CONFIG.PSU__DDRC__T_FAW 30 \
 CONFIG.PSU__DDRC__T_RAS_MIN 33 \
 CONFIG.PSU__DDRC__T_RC 49 \
 CONFIG.PSU__DDRC__ECC Disabled \
 CONFIG.PSU__DDRC__DM_DBI DM_NO_DBI \
 CONFIG.PSU__DDRC__PHY_DBI_MODE 0 \
 CONFIG.PSU__DDRC__DDR4_CRC_CONTROL 0 \
 CONFIG.PSU__DDRC__PARITY_ENABLE 0 \
 CONFIG.PSU__DDRC__TRAIN_DATA_EYE 1 \
 CONFIG.PSU__DDRC__TRAIN_READ_GATE 1 \
 CONFIG.PSU__DDRC__TRAIN_WRITE_LEVEL 1 \
 CONFIG.PSU__CRL_APB__PL0_REF_CTRL__SRCSEL DPLL \
 CONFIG.PSU__NUM_FABRIC_RESETS 1 \
 CONFIG.PSU__USE__IRQ0 1 \
 CONFIG.PSU__UART0__PERIPHERAL__ENABLE 1 \
 CONFIG.PSU__UART0__PERIPHERAL__IO {MIO 42 .. 43} \
 CONFIG.PSU__UART0__BAUD_RATE 115200 \
 CONFIG.PSU_BANK_0_IO_STANDARD LVCMOS18 \
 CONFIG.PSU_BANK_1_IO_STANDARD LVCMOS18 \
 CONFIG.PSU_BANK_2_IO_STANDARD LVCMOS18] [get_bd_cells ps]
